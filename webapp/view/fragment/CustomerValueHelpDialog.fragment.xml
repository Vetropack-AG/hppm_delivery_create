<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		title="{i18n>customerValueHelpDialog.title}"
		search="onCustomerValueHelpSearch"
		confirm="onCustomerValueHelpConfirm"
		items="{/CustomerValueHelpSet}">
		<StandardListItem
			title="{Description}"
			description="{Key}"
			info="{Country}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>