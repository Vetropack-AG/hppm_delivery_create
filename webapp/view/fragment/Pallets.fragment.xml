<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Table id="Pallets" items="{Pallets>/}" mode="Delete" delete="onPalletDelete">
		<headerToolbar>
			<OverflowToolbar >
				<Title text="{i18n>main.pallets}" level="H2"/>
				<ToolbarSpacer/>
				<Button type="Transparent" tooltip="{i18n>general.add}" icon="sap-icon://add" press="onAddPalletPress"/>
			</OverflowToolbar>
		</headerToolbar>
		<columns>
			<Column>
				<Text text="{i18n>main.carrierType}"/>
			</Column>
			<Column width="18%" minScreenWidth="Desktop" demandPopin="true">
				<Text text="{i18n>main.customerPackagingStock}"/>
			</Column>
			<Column width="20%" minScreenWidth="Desktop" demandPopin="true">
				<Text text="{i18n>main.amount}"/>
			</Column>
		</columns>
		<items>
			<ColumnListItem>
				<cells>
					<ComboBox width="100%" 
						required="true"
						id="LoadCarrierType"
						items="{ path: '/LoadCarrierTypeValueHelpSet', templateShareable: false}" 
						selectedKey="{Pallets>MaterialNumber}" 
						showSecondaryValues="false" 
						filterSecondaryValues="true"
						selectionChange="onLoadCarrierTypeSelectionChange">
							<core:ListItem key="{Key}" text="{Key} - {Description}" additionalText="{Key}" />
					</ComboBox>
					<Select width="100%"
						id="SpecialStock" 
						change="onSpecialStockChange"
						selectedKey="{Pallets>SpecialStock}"
						forceSelection="false"
						items="{
					        path : '/SpecialStockValueHelpSet',
					        templateShareable: false,
					        filters : [
					            { path : 'Key', operator : 'EQ', value1 : 'O' },
					            { path : 'Key', operator : 'EQ', value1 : 'V' }
					        ]
					    }">
							<core:Item key="{Key}" text="{Description}" />
					</Select>
					
					<HBox width="100%" id="Quantity">
						<Input value="{ path:'Pallets>Quantity', type:'sap.ui.model.odata.type.Decimal' }" type="Number" change="onMaterialQuantityChange"/>
						<Button icon="sap-icon://simulate" tooltip="{i18n.main.calculate}" press="onOpenCalulatorPress"/>
					</HBox>
				</cells>
			</ColumnListItem>
		</items>
	</Table>
</core:FragmentDefinition>