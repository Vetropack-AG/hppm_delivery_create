<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		title="{i18n>plantValueHelpDialog.title}"
		search="onOwnerValueHelpSearch"
		confirm="onOwnerValueHelpConfirm"
		items="{/PlantValueHelpSet}">
		<StandardListItem
			title="{Description}"
			description="{Key}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>