<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core" 	
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form">
			<f:SimpleForm
			id="LoadingInformationSimpleForm"
			editable="true"
			layout="ResponsiveGridLayout"
			labelSpanXL="4"
			labelSpanL="4"
			labelSpanM="12"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="0"
			emptySpanL="0"
			emptySpanM="0"
			emptySpanS="0"
			columnsXL="2"
			columnsL="2"
			columnsM="2"
			singleContainerFullSize="false" 
			class="vpUiFormRespGridNoPaddingBotton">
			<f:content>
				<core:Title text="{i18n>main.loadAt}" />
				<Label text="{i18n>main.customer}" />
				<Input 
					showValueHelp="true" 
					required="true" 
					fieldGroupIds="LoadingInformation" 
					valueHelpRequest="onLoadAtCustomerValueHelpRequest" 
					change="onLoadAtCustomerChange"
					value="{ parts: [ {path:'SoldToParty'}, {path: 'SoldToPartyText'} ], formatter:'.formatter.descriptionAndKey'}"
					/>
					
				<Label text="{i18n>main.pickupDate}" />
				<DateTimePicker 
					placeholder="{i18n>main.fromPlaceholer}" 
					required="true" 
					change="setVariantDirty"
					fieldGroupIds="LoadingInformation"
					value="{ path: 'PickUpDateFrom', type: 'sap.ui.model.odata.type.DateTime', formatOptions: { style: 'short' } }"/>
				<DateTimePicker 
					placeholder="{i18n>main.untilPlaceholer}" 
					required="true" 
					change="setVariantDirty"
					fieldGroupIds="LoadingInformation"
					value="{ path: 'PickUpDateUntil', type: 'sap.ui.model.odata.type.DateTime', formatOptions: { style: 'short' } }"/>
					
				<Label text="{i18n>main.customerDeliveryNo}" />
				<Input 
					required="true" 
					fieldGroupIds="LoadingInformation"
					value="{CustomerDelivery}"
					change="setVariantDirty" />
				
				<Label text="{i18n>main.transportBy}"/>
				<RadioButtonGroup columns="2" select="onTransportBySelect" selectedIndex="-1" fieldGroupIds="LoadingInformation" id="incotermGroup">
					<RadioButton  text="{i18n>main.transportByVetropack}" />
					<RadioButton  text="{i18n>main.transportByCustomer}" />
				</RadioButtonGroup>
		
				<core:Title text="{i18n>main.unloadAt}" />
				<Label text="{i18n>main.location}" />
				<Input 
					showValueHelp="true" 
					required="true" 
					fieldGroupIds="LoadingInformation" 
					valueHelpRequest="onUnloadAtCustomerValueHelpRequest" 
					change="onUnloadAtCustomerChange"
					value="{ parts: [ {path:'ShipToParty'}, {path: 'ShipToPartyText'} ], formatter:'.formatter.descriptionAndKey'}" />
					
				<Label text="{i18n>main.deliveryDate}" />
				<DateTimePicker 
					placeholder="{i18n>main.fromPlaceholer}" 
					required="true" 
					fieldGroupIds="LoadingInformation"
					change="setVariantDirty"
					value="{ path: 'DeliveryDateFrom', type: 'sap.ui.model.odata.type.DateTime', formatOptions: { style: 'short' } }"/>
				<DateTimePicker 
					placeholder="{i18n>main.untilPlaceholer}" 
					required="true" 
					fieldGroupIds="LoadingInformation"
					change="setVariantDirty"
					value="{ path: 'DeliveryDateUntil', type: 'sap.ui.model.odata.type.DateTime', formatOptions: { style: 'short' } }"/>
					
				<Label text="{i18n>main.owner}" />
				<Input 
					showValueHelp="true" 
					required="true" 
					fieldGroupIds="LoadingInformation"
					valueHelpRequest="onOwnerValueHelpRequest" 
					change="onOwnerChange"
					value="{ parts: [ {path:'Owner'}, {path: 'OwnerText'} ], formatter:'.formatter.descriptionAndKey'}"/>
					
				<Label text="{i18n>main.truckNo}" />
				<Input 
					fieldGroupIds="LoadingInformation"
					change="setVariantDirty"
					value="{TruckNumber}"/>
			</f:content>
		</f:SimpleForm>
		
		<f:SimpleForm
			editable="true"
			layout="ResponsiveGridLayout"
			labelSpanXL="2"
			labelSpanL="2"
			labelSpanM="12"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="0"
			emptySpanL="0"
			emptySpanM="0"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" 
			validateFieldGroup="onLoadingInformationValidate"
			class="vpUiFormRespGridNoPaddingTop">
			<f:content>
				<Label text="{i18n>main.comment}" />
				<TextArea value="{Comment}" change="setVariantDirty"/>
			</f:content>
		</f:SimpleForm>
		
</core:FragmentDefinition>
