<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" >
	<Dialog title="{i18n>layersCalculatorDialog.title}" contentWidth="{= ${device>/system/desktop} ? 'auto' : '95%' }">
		<!--<hppm:LayersCalculator calculationConstant="0.35"/>   xmlns:hppm="zvgt.hppm.controls"-->
		<beginButton>
			<Button text="{i18n>general.ok}" type="Emphasized" press="onCalculatorOkPress"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>general.cancel}" press="closeDialogByEvent"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>