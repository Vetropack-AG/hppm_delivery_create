{
    "name": "zvgt.hppm.delivery_create",
    "version": "0.0.1",
    "description": "",
    "devDependencies": {
        "@sap/ui5-builder-webide-extension": "1.0.x",
        "@sap/ux-ui5-tooling": "1",
        "@ui5/cli": "^2.14.1",
        "mbt": "^1.2.18",
        "rimraf": "3.0.2",
        "ui5-task-flatten-library": "0.2.5",
        "ui5-task-zipper": "^0.5.0"
    },
    "scripts": {
        "start": "fiori run --open \"test/flpSandbox.html?sap-client=200&sap-ui-xx-viewCache=false#app-tile\"",
        "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandboxMockServer.html?sap-client=200&sap-ui-xx-viewCache=false#app-tile\"",
        "start-noflp": "fiori run --open \"index.html?sap-client=200&sap-ui-xx-viewCache=false\"",
        "start-variants-management": "fiori run --open \"preview.html?sap-client=200&sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\"",     
        "start-mock": "fiori run --open \"test/flpSandboxMockServer.html?sap-client=200&sap-ui-xx-viewCache=false#app-tile\"",
        "suite-tests": "fiori run --open 'test/testsuite.qunit.html'",
        "unit-tests": "fiori run --open 'test/unit/unitTests.qunit.html'",
        "int-tests": "fiori run --open 'test/integration/opaTests.qunit.html'",

        "deploy-config": "fiori add deploy-config",

        "deploy:ui5": "npm run build && fiori deploy --config ui5-deploy.yaml && rimraf archive.zip",
        "build:ui5": "ui5 build -a --clean-dest --include-task=generateManifestBundle generateCachebusterInfo",
        "undeploy:ui5": "fiori undeploy --config ui5-deploy.yaml",
       
        "build:cf": "npm run copy:lib && ui5 build preload --clean-dest --config cf-deploy.yaml --include-task=generateCachebusterInfo",
        "build:mta": "rimraf resources mta_archives && mbt build",
        "copy:lib": "cp -r ../onpremise_hppm_controls/src/zvgt ./webapp",
        "remove:lib": "rm -r ./webapp/zvgt",
        "do_deploy:cf": "fiori cfDeploy",
        "deploy:cf": "npm run do_build:cf && echo '\nWaiting 5 seconds before deployment...\n' && npm run do_deploy:cf",
        "undeploy:cf": "cf undeploy zvgthppmdeliverycreate --delete-services --delete-service-keys --delete-service-brokers",
        "do_build:cf": "npm run copy:lib && npm run build:cf && echo '\nWaiting 5 seconds for build to continue...\n' && sleep 5 && npm run build:mta && echo '\nWaiting 2 seconds for build to continue...\n' && sleep 2 && npm run remove:lib"
    },
    "ui5": {
        "dependencies": [
            "@sap/ux-ui5-tooling",
            "ui5-task-flatten-library",
            "@sap/ui5-builder-webide-extension",
            "ui5-task-zipper",
            "mbt"
        ]
    },
    "private": true,
    "sapuxLayer": "CUSTOMER_BASE",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "dependencies": {
        "@sap/approuter": "^14.1.1"
    }
}
